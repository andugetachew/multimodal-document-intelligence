{
  "info": {
    "name": "Multimodal Document Intelligence",
    "description": "AI-powered document processing API with intelligent routing — classifies documents and extracts text via native parsing, OCR, DOCX/CSV parsing, or vision-model fallback based on confidence scoring.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8020",
      "type": "string"
    },
    {
      "key": "document_id",
      "value": "",
      "type": "string",
      "description": "Auto-populated after a successful upload via the test script below"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        }
      },
      "response": []
    },
    {
      "name": "Upload Document",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "    const jsonData = pm.response.json();",
              "    pm.collectionVariables.set('document_id', jsonData.id);",
              "    console.log('Saved document_id:', jsonData.id);",
              "}",
              "",
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has id and pending status', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.expect(jsonData.status).to.eql('pending');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/documents/upload",
          "host": ["{{base_url}}"],
          "path": ["documents", "upload"]
        },
        "description": "Upload a PDF, image (.png/.jpg/.jpeg/.webp/.tiff/.bmp), .docx, or .csv file. Select a file in the 'file' form field before sending. Returns immediately with status 'pending' — processing happens asynchronously."
      },
      "response": []
    },
    {
      "name": "Get Document by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Log current processing status', function () {",
              "    const jsonData = pm.response.json();",
              "    console.log('Document status:', jsonData.status);",
              "    console.log('Extraction method:', jsonData.extraction_method);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/documents/{{document_id}}",
          "host": ["{{base_url}}"],
          "path": ["documents", "{{document_id}}"]
        },
        "description": "Fetch the current state of a document. Poll this after upload — status progresses pending -> processing -> completed (or failed)."
      },
      "response": []
    },
    {
      "name": "List Documents",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/documents?limit=20&offset=0",
          "host": ["{{base_url}}"],
          "path": ["documents"],
          "query": [
            {
              "key": "limit",
              "value": "20",
              "description": "Max results, 1-100"
            },
            {
              "key": "offset",
              "value": "0",
              "description": "Pagination offset"
            }
          ]
        },
        "description": "Lists documents, most recently created first."
      },
      "response": []
    },
    {
      "name": "Delete Document",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 204', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/documents/{{document_id}}",
          "host": ["{{base_url}}"],
          "path": ["documents", "{{document_id}}"]
        },
        "description": "Deletes the document's database record and its file in storage. Returns 204 No Content on success, 404 if the document doesn't exist."
      },
      "response": []
    },
    {
      "name": "Get Document - Not Found (404 example)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/documents/00000000-0000-0000-0000-000000000000",
          "host": ["{{base_url}}"],
          "path": ["documents", "00000000-0000-0000-0000-000000000000"]
        },
        "description": "Demonstrates the 404 response for a non-existent document ID."
      },
      "response": []
    }
  ]
}